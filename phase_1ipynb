    "# Cell 3 - Train KNN Model\n",
    "# FIX: Training data aligned with actual obstacles: (3,2) and (4,5)\n",
    "# Removed [4,3] obstacle (it does NOT exist in grid)\n",
    "# Added [5,5],[5,4],[5,3] as caution so model doesn't predict them as obstacle\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "\n",
    "training_data = [\n",
    "    # Safe zones\n",
    "    ([0, 0], \"safe\"),\n",
    "    ([0, 1], \"safe\"),\n",
    "    ([0, 2], \"safe\"),\n",
    "    ([0, 3], \"safe\"),\n",
    "    ([1, 0], \"safe\"),\n",
    "    ([1, 1], \"safe\"),\n",
    "    ([1, 2], \"safe\"),\n",
    "    ([2, 0], \"safe\"),\n",
    "    ([2, 1], \"safe\"),\n",
    "    ([3, 0], \"safe\"),\n",
    "    # Caution zones\n",
    "    ([2, 2], \"caution\"),\n",
    "    ([2, 3], \"caution\"),\n",
    "    ([2, 4], \"caution\"),\n",
    "    ([2, 5], \"caution\"),\n",
    "    ([3, 1], \"caution\"),\n",
    "    ([3, 3], \"caution\"),\n",
    "    ([4, 0], \"caution\"),\n",
    "    ([4, 1], \"caution\"),\n",
    "    ([5, 0], \"caution\"),\n",
    "    ([5, 1], \"caution\"),\n",
    "    ([5, 2], \"caution\"),\n",
    "    ([5, 3], \"caution\"),\n",
    "    ([5, 4], \"caution\"),\n",
    "    ([5, 5], \"caution\"),\n",
    "    # Obstacle zones \u2014 only actual obstacles\n",
    "    ([3, 2], \"obstacle\"),\n",
    "    ([4, 5], \"obstacle\"),\n",
    "]\n",
    "\n",
    "X = []\n",
    "y = []\n",
    "for coords, label in training_data:\n",
    "    X.append(coords)\n",
    "    y.append(label)\n",
    "\n",
    "model = KNeighborsClassifier(n_neighbors=3)\n",
    "model.fit(X, y)\n",
    "print(\"Model trained successfully!\")"
   ]
  },
