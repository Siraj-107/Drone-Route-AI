    "# Cell 1 - Obstacle Class\n",
    "class Obstacle:\n",
    "    def __init__(self, x, y):\n",
    "        self.x = x\n",
    "        self.y = y\n",
    "\n",
    "    def get_position(self):\n",
    "        return (self.x, self.y)\n",
    "\n",
    "    def __repr__(self):\n",
    "        return f\"Obstacle( {self.x} ,{self.y} ) \"\n",
    "\n",
    "x1 = Obstacle(3, 2)\n",
    "print(f\"{x1}\")"
   ]
